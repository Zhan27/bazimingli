{
  "name": "bazimingli",
  "version": "5.27.0",
  "description": "Single-file traditional calendrical chart application",
  "main": "lib/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm run lint && npm test && npm run test:desktop && npm run test:e2e",
    "test:desktop": "python -m unittest discover -s tests -p test_launcher.py",
    "regression": "node scripts/regression.cjs",
    "lint": "node scripts/lint.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhan27/bazimingli.git"
  },
  "keywords": [],
  "author": "Zhan27",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Zhan27/bazimingli/issues"
  },
  "homepage": "https://github.com/Zhan27/bazimingli#readme",
  "dependencies": {
    "lunar-javascript": "1.7.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "acorn": "8.15.0",
    "astronomy-engine": "2.1.19",
    "eslint": "10.13.0"
  },
  "private": true
}
